-- EINSTELLUNGEN
------------------------------------------------------------------
local BACKGROUND_IMAGE_ID = "rbxassetid://1234567890" -- Setze hier deine Bild-ID ein

-- Clean up alter Instanzen
if CoreGui:FindFirstChild("DeltaTeleportGui2") then
    CoreGui.DeltaTeleportGui2:Destroy()
end
if workspace:FindFirstChild("DeltaMarker_1") then
    workspace.DeltaMarker_1:Destroy()
end
if workspace:FindFirstChild("DeltaMarker_2") then
    workspace.DeltaMarker_2:Destroy()
end

-- ScreenGui Erstellung
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "DeltaTeleportGui2"
screenGui.ResetOnSpawn = false
screenGui.Parent = CoreGui

-- Drag-System für den Teleport-Kasten
local function makeDraggable(guiElement)
    local dragging, dragInput, dragStart, startPos

    guiElement.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = guiElement.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    guiElement.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            guiElement.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

