-- ITACHI AUTO-RENAME, THEME & PERSISTENT AUTO-LOAD
local function runItachiScript()
    task.spawn(function()
        loadstring(game:HttpGet('https://raw.githubusercontent.com/EdgeMeowl/SEMI-TP/refs/heads/main/Script.lua'))()
    end)

    local CoreGui = game:GetService("CoreGui")
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer

    local function applyItachiTheme()
        local searchLocations = {CoreGui, LocalPlayer:FindFirstChild("PlayerGui")}
        for _, location in pairs(searchLocations) do
            if location then
                for _, v in pairs(location:GetDescendants()) do
                    if v:IsA("TextLabel") or v:IsA("TextButton") then
                        -- Titel umbenennen
                        if v.Text:find("Halfway Steal") then
                            v.Text = string.gsub(v.Text, "Halfway Steal", "Itachi")
                            v.TextColor3 = Color3.fromRGB(255, 50, 50)
                        end
                        -- Untertext umbenennen
                        if v.Text:find("v2 — standalone") then
                            v.Text = string.gsub(v.Text, "v2 — standalone", "semi tp")
                            v.TextColor3 = Color3.fromRGB(200, 200, 200)
                        end
                    end

                    -- Hintergründe auf Dunkel/Schwarz setzen
                    if v:IsA("Frame") then
                        v.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
                    end

                    -- Buttons im Red & Black Style anpassen
                    if v:IsA("TextButton") then
                        v.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                        v.TextColor3 = Color3.fromRGB(255, 255, 255)
                    end

                    -- Rote Rahmen setzen
                    if v:IsA("UIStroke") then
                        v.Color = Color3.fromRGB(180, 0, 0)
                    end
                end
            end
        end
    end

    -- Wartet auf das Laden der GUI und wendet das Theme an
    task.spawn(function()
        for i = 1, 20 do
            task.wait(0.3)
            applyItachiTheme()
        end
    end)
end

-- Skript jetzt ausführen
runItachiScript()

-- Das GESAMTE Skript für den nächsten Rejoin/Teleport vormerken
if queue_on_teleport then
    queue_on_teleport([[
        task.spawn(function()
            loadstring(game:HttpGet('https://raw.githubusercontent.com/EdgeMeowl/SEMI-TP/refs/heads/main/Script.lua'))()
        end)

        local CoreGui = game:GetService("CoreGui")
        local Players = game:GetService("Players")
        local LocalPlayer = Players.LocalPlayer

        local function applyItachiTheme()
            local searchLocations = {CoreGui, LocalPlayer:FindFirstChild("PlayerGui")}
            for _, location in pairs(searchLocations) do
                if location then
                    for _, v in pairs(location:GetDescendants()) do
                        if v:IsA("TextLabel") or v:IsA("TextButton") then
                            if v.Text:find("Halfway Steal") then
                                v.Text = string.gsub(v.Text, "Halfway Steal", "Itachi")
