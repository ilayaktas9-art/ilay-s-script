container.BackgroundTransparency = 1
container.Parent = mainFrame

local UIListLayout = Instance.new("UIListLayout")
UIListLayout.Padding = UDim.new(0, 8)
UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
UIListLayout.Parent = container

-- Funktion zum Erstellen der Red/Black Buttons
local function createButton(text, order, onClickFunction)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 35)
    btn.BackgroundColor3 = Color3.fromRGB(30, 10, 10)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 13
    btn.Font = Enum.Font.SourceSansBold
    btn.LayoutOrder = order
    btn.Parent = container

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(150, 0, 0)
    stroke.Thickness = 1
    stroke.Parent = btn

    btn.MouseButton1Click:Connect(onClickFunction)
end

-- 1. Knopf: Sharingan Script direkt laden
createButton("Sharingan", 1, function()
    loadstring(game:HttpGet("https://raw.githubusercontent.com/ilayaktas9-art/ilay-s-script/main/sharingan?v="..math.random()))()
end)

-- 2. Knopf: Semi TP
