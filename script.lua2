------------------------------------------------------------------
-- LOGIK & EVENTS
------------------------------------------------------------------

-- Link kopieren
btnGetKey.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(TIKTOK_LINK)
        btnGetKey.Text = "Copied!"
        task.wait(1.5)
        btnGetKey.Text = "Get Key"
    else
        btnGetKey.Text = "Copied!"
    end
end)

-- Key überprüfen
btnUnlock.MouseButton1Click:Connect(function()
    local enteredText = string.gsub(keyTextBox.Text, "^%s*(.-)%s*$", "%1")
    enteredText = string.upper(enteredText)

    if enteredText == string.upper(CORRECT_KEY) then
        keyFrame:Destroy()
        openBtn.Visible = true
    else
        btnUnlock.Text = "Wrong Key!"
        btnUnlock.BackgroundColor3 = Color3.fromRGB(80, 0, 0)
        task.wait(1.5)
        btnUnlock.Text = "Unlock"
        btnUnlock.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    end
end)

-- Open Button Toggle
openBtn.MouseButton1Click:Connect(function() 
    frame.Visible = not frame.Visible 
end)

-- ESP Logik
local function createBox(player)
    if player == LocalPlayer or not player.Character then return end
    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    if hrp and not hrp:FindFirstChild("ESP_BOX") then
        local box = Instance.new("BoxHandleAdornment")
        box.Name = "ESP_BOX"
        box.Size = hrp.Size
        box.Color3 = Color3.fromRGB(255, 0, 0)
        box.Transparency = 0.4
        box.AlwaysOnTop = true
        box.ZIndex = 10
        box.Adornee = hrp
        box.Parent = hrp
        activeESPParts[player.Name] = box
    end
end

local function removeESP(player)
    if activeESPParts[player.Name] then
        activeESPParts[player.Name]:Destroy()
        activeESPParts[player.Name] = nil
    end
end

toggleBtn.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    if espEnabled then
        toggleBtn.Text = "ESP: ON"
        toggleBtn.TextColor3 = Color3.fromRGB(0, 255, 0)
        for _, p in pairs(Players:GetPlayers()) do createBox(p) end
    else
        toggleBtn.Text = "ESP: OFF"
        toggleBtn.TextColor3 = Color3.fromRGB(255, 50, 50)
        for _, p in pairs(Players:GetPlayers()) do removeESP(p) end
    end
end)

-- Updates für neue Spieler / Respawns
Players.PlayerAdded:Connect(function(p) 
    p.CharacterAdded:Connect(function() 
        if espEnabled then 
            task.wait(0.5)
            createBox(p) 
        end 
    end) 
end)

Players.PlayerRemoving:Connect(removeESP)
