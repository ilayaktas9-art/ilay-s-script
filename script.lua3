local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

------------------------------------------------------------------
-- EINSTELLUNGEN
------------------------------------------------------------------

-- Clean up alter Instanzen
if CoreGui:FindFirstChild("UchiaHubGui") then CoreGui.UchiaHubGui:Destroy() end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "UchiaHubGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = CoreGui

-- Drag System (Touch & Maus)
local function makeDraggable(gui)
    local dragging, dragInput, dragStart, startPos
    gui.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = gui.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            gui.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    gui.InputEnded:Connect(function(input) 
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
            dragging = false 
        end 
    end)
end

------------------------------------------------------------------
-- HAUPT MENÜ (UCHIA SPEED/JUMP)
------------------------------------------------------------------
local openBtn = Instance.new("TextButton", screenGui)
openBtn.Size = UDim2.new(0, 110, 0, 40)
openBtn.Position = UDim2.new(0, 10, 0.5, 0)
openBtn.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
openBtn.TextColor3 = Color3.fromRGB(255, 0, 0)
openBtn.Text = "Open UCHIA"
openBtn.Font = Enum.Font.SourceSansBold
openBtn.Visible = true -- Direkt sichtbar!
makeDraggable(openBtn)

local frame = Instance.new("Frame", screenGui)
frame.Size = UDim2.new(0, 230, 0, 200)
frame.Position = UDim2.new(0.5, -115, 0.5, -100)
frame.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
frame.BorderSizePixel = 2
frame.BorderColor3 = Color3.fromRGB(255, 0, 0)
frame.Active = true
frame.Visible = false
makeDraggable(frame)

-- Titel
local title = Instance.new("TextLabel", frame)
title.Size = UDim2.new(1, 0, 0, 30)
title.BackgroundTransparency = 1
title.Text = "UCHIA SPEED/JUMP"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.Font = Enum.Font.SourceSansBold
title.TextSize = 18

-- SPEED CHANGER
local speedBox = Instance.new("TextBox", frame)
speedBox.Size = UDim2.new(0.6, 0, 0, 35)
speedBox.Position = UDim2.new(0.05, 0, 0.25, 0)
speedBox.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
speedBox.PlaceholderText = "Speed..."
speedBox.Text = ""
speedBox.TextColor3 = Color3.fromRGB(255, 255, 255)
speedBox.Font = Enum.Font.SourceSans

local speedBtn = Instance.new("TextButton", frame)
speedBtn.Size = UDim2.new(0.28, 0, 0, 35)
speedBtn.Position = UDim2.new(0.67, 0, 0.25, 0)
speedBtn.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
speedBtn.Text = "Set"
speedBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
speedBtn.Font = Enum.Font.SourceSansBold

-- JUMP CHANGER
local jumpBox = Instance.new("TextBox", frame)
jumpBox.Size = UDim2.new(0.6, 0, 0, 35)
jumpBox.Position = UDim2.new(0.05, 0, 0.55, 0)
jumpBox.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
jumpBox.PlaceholderText = "Jump..."
jumpBox.Text = ""
jumpBox.TextColor3 = Color3.fromRGB(255, 255, 255)
jumpBox.Font = Enum.Font.SourceSans

local jumpBtn = Instance.new("TextButton", frame)
jumpBtn.Size = UDim2.new(0.28, 0, 0, 35)
jumpBtn.Position = UDim2.new(0.67, 0, 0.55, 0)
jumpBtn.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
jumpBtn.Text = "Set"
jumpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
jumpBtn.Font = Enum.Font.SourceSansBold

------------------------------------------------------------------
-- LOGIK & EVENTS
------------------------------------------------------------------
openBtn.MouseButton1Click:Connect(function()
    frame.Visible = not frame.Visible
end)

-- Speed Anpassen
speedBtn.MouseButton1Click:Connect(function()
    local val = tonumber(speedBox.Text)
    if val and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = val
    end
end)

-- Jump Anpassen
jumpBtn.MouseButton1Click:Connect(function()
    local val = tonumber(jumpBox.Text)
    if val and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.UseJumpPower = true
        LocalPlayer.Character.Humanoid.JumpPower = val
    end
end)
