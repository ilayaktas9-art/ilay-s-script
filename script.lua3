------------------------------------------------------------------
-- LOGIK & EVENTS
------------------------------------------------------------------
btnGetKey.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(TIKTOK_LINK)
        btnGetKey.Text = "Copied!"
        task.wait(1.5)
        btnGetKey.Text = "Get Key"
    end
end)

btnUnlock.MouseButton1Click:Connect(function()
    local enteredText = string.gsub(keyTextBox.Text, "^%s*(.-)%s*$", "%1")
    if string.upper(enteredText) == string.upper(CORRECT_KEY) then
        keyFrame:Destroy()
        openBtn.Visible = true
    else
        btnUnlock.Text = "Wrong Key!"
        task.wait(1.5)
        btnUnlock.Text = "Unlock"
    end
end)

openBtn.MouseButton1Click:Connect(function()
    frame.Visible = not frame.Visible
end)

-- Speed Anpassen
speedBtn.MouseButton1Click:Connect(function()
    local val = tonumber(speedBox.Text)
    if val and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = val
    end
end)

-- Jump Anpassen
jumpBtn.MouseButton1Click:Connect(function()
    local val = tonumber(jumpBox.Text)
    if val and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.UseJumpPower = true
        LocalPlayer.Character.Humanoid.JumpPower = val
    end
end)
