openBtn.BorderColor3 = Color3.fromRGB(255, 0, 50)
openBtn.TextColor3 = Color3.fromRGB(255, 0, 50)
openBtn.Text = "Open UCHIA"
openBtn.Font = Enum.Font.SourceSansBold
openBtn.Visible = true -- Direkt aktiv ohne Key
makeDraggable(openBtn)

local frame = Instance.new("Frame", screenGui)
frame.Size = UDim2.new(0, 230, 0, 220)
frame.Position = UDim2.new(0.5, -115, 0.5, -110)
frame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
frame.BorderSizePixel = 2
frame.BorderColor3 = Color3.fromRGB(255, 0, 50)
frame.Active = true
frame.Visible = false
makeDraggable(frame)

local title = Instance.new("TextLabel", frame)
title.Size = UDim2.new(1, 0, 0, 30)
