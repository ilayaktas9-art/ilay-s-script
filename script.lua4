-- Dropdown Button
local dropdownBtn = Instance.new("TextButton", frame)
dropdownBtn.Size = UDim2.new(0.9, 0, 0, 35)
dropdownBtn.Position = UDim2.new(0.05, 0, 0.2, 0)
dropdownBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
dropdownBtn.BorderColor3 = Color3.fromRGB(255, 0, 50)
dropdownBtn.Text = "Select Player ▼"
dropdownBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
dropdownBtn.Font = Enum.Font.SourceSans

-- Scroll-Liste für Spieler
local scrollList = Instance.new("ScrollingFrame", frame)
scrollList.Size = UDim2.new(0.9, 0, 0, 80)
scrollList.Position = UDim2.new(0.05, 0, 0.38, 0)
scrollList.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
scrollList.BorderColor3 = Color3.fromRGB(100, 0, 20)
scrollList.CanvasSize = UDim2.new(0, 0, 0, 0)
scrollList.Visible = false
scrollList.ScrollBarThickness = 4

local uiListLayout = Instance.new("UIListLayout", scrollList)
uiListLayout.SortOrder = Enum.SortOrder.LayoutOrder

-- Toggle Follow Button
local toggleBtn = Instance.new("TextButton", frame)
toggleBtn.Size = UDim2.new(0.9, 0, 0, 40)
toggleBtn.Position = UDim2.new(0.05, 0, 0.78, 0)
toggleBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
toggleBtn.BorderColor3 = Color3.fromRGB(255, 0, 50)
toggleBtn.Text = "Follow: OFF"
toggleBtn.TextColor3 = Color3.fromRGB(255, 0, 50)
toggleBtn.TextSize = 15
toggleBtn.Font = Enum.Font.SourceSansBold

------------------------------------------------------------------
-- DROPDOWN SPIELER-LISTE LOGIK
------------------------------------------------------------------
local function updatePlayerList()
    for _, child in ipairs(scrollList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local count = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            count = count + 1
            local pBtn = Instance.new("TextButton", scrollList)
            pBtn.Size = UDim2.new(1, 0, 0, 25)
            pBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            pBtn.BorderSizePixel = 0
            pBtn.Text = p.DisplayName .. " (@" .. p.Name .. ")"
            pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            pBtn.Font = Enum.Font.SourceSans
            pBtn.TextSize = 12

            pBtn.MouseButton1Click:Connect(function()
                selectedPlayer = p
                dropdownBtn.Text = p.DisplayName
                scrollList.Visible = false
            end)
        end
    end
    scrollList.CanvasSize = UDim2.new(0, 0, 0, count * 25)
end

dropdownBtn.MouseButton1Click:Connect(function()
    scrollList.Visible = not scrollList.Visible
    if scrollList.Visible then updatePlayerList() end
end)

Players.PlayerAdded:Connect(updatePlayerList)
Players.PlayerRemoving:Connect(function(p)
    if selectedPlayer == p then
        selectedPlayer = nil
        dropdownBtn.Text = "Select Player ▼"
    end
    updatePlayerList()
end)

------------------------------------------------------------------
-- MENÜ TOGGLE & FOLLOW LOGIK
------------------------------------------------------------------
openBtn.MouseButton1Click:Connect(function()
    frame.Visible = not frame.Visible
end)

local function stopFollowing()
    isFollowing = false
    toggleBtn.Text = "Follow: OFF"
    toggleBtn.TextColor3 = Color3.fromRGB(255, 0, 50)
    if followConnection then
        followConnection:Disconnect()
        followConnection = nil
    end
end

toggleBtn.MouseButton1Click:Connect(function()
    isFollowing = not isFollowing

    if isFollowing then
        if not selectedPlayer then
            isFollowing = false
            toggleBtn.Text = "No Target Selected!"
            task.wait(1.5)
            toggleBtn.Text = "Follow: OFF"
            return
        end

        toggleBtn.Text = "Follow: ON"
        toggleBtn.TextColor3 = Color3.fromRGB(0, 255, 100)

        followConnection = RunService.RenderStepped:Connect(function()
            if selectedPlayer and selectedPlayer.Character and selectedPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local targetHRP = selectedPlayer.Character.HumanoidRootPart
                local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

                if myHRP then
                    myHRP.CFrame = targetHRP.CFrame * CFrame.new(OFFSET)
                end
            else
                stopFollowing()
            end
        end)
    else
        stopFollowing()
    end
end)
