local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

------------------------------------------------------------------
-- EINSTELLUNGEN & VARIABLEN
------------------------------------------------------------------
local selectedPlayer = nil
local isFollowing = false
local followConnection = nil
local OFFSET = Vector3.new(0, 0, 3) -- Abstand zum Zielspieler (3 Studs dahinter)

-- Clean up alter Instanzen
if CoreGui:FindFirstChild("UchiaTargetGui") then 
    CoreGui.UchiaTargetGui:Destroy() 
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "UchiaTargetGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = CoreGui

-- Drag System (Touch & Maus)
local function makeDraggable(gui)
    local dragging, dragInput, dragStart, startPos
    gui.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = gui.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            gui.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    gui.InputEnded:Connect(function(input) 
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
            dragging = false 
        end 
    end)
end

------------------------------------------------------------------
-- HAUPT MENÜ (NEUES DESIGN & DROPDOWN)
------------------------------------------------------------------
local openBtn = Instance.new("TextButton", screenGui)
openBtn.Size = UDim2.new(0, 110, 0, 40)
