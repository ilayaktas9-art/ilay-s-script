-- Link kopieren
btnGetKey.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(TIKTOK_LINK)
        btnGetKey.Text = "Copied!"
        task.wait(1.5)
        btnGetKey.Text = "Get Key"
    else
        btnGetKey.Text = "Copied!"
    end
end)

-- Key überprüfen
btnUnlock.MouseButton1Click:Connect(function()
    local enteredText = string.gsub(keyTextBox.Text, "^%s*(.-)%s*$", "%1")
    enteredText = string.upper(enteredText)

    if enteredText == string.upper(CORRECT_KEY) then
        keyFrame:Destroy()
        frame.Visible = true
    else
        btnUnlock.Text = "Wrong Key!"
        btnUnlock.BackgroundColor3 = Color3.fromRGB(80, 0, 0)
        task.wait(1.5)
        btnUnlock.Text = "Unlock"
        btnUnlock.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    end
end)

-- Checkpoint & Teleport Logik (Punkte: 1 = Rot, 2 = Schwarz)
local savedCFrame1 = nil
local savedCFrame2 = nil
local markerPart1 = nil
local markerPart2 = nil

local function updateMarker(id, cf, color)
    local markerName = "DeltaMarker_" .. id
    local currentMarker = (id == 1) and markerPart1 or markerPart2

    if not currentMarker or not currentMarker.Parent then
        currentMarker = Instance.new("Part")
        currentMarker.Name = markerName
        currentMarker.Shape = Enum.PartType.Cylinder
        currentMarker.Size = Vector3.new(0.3, 4, 4)
        currentMarker.Color = color
        currentMarker.Material = Enum.Material.Neon
        currentMarker.Transparency = 0.2
        currentMarker.Anchored = true
        currentMarker.CanCollide = false
        currentMarker.Parent = workspace

        if id == 1 then markerPart1 = currentMarker else markerPart2 = currentMarker end
    end

    currentMarker.CFrame = CFrame.new(cf.Position - Vector3.new(0, 2.8, 0)) * CFrame.Angles(0, 0, math.rad(90))
end

-- Punkt 1 (ROT)
saveBtn1.MouseButton1Click:Connect(function()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        savedCFrame1 = hrp.CFrame
        updateMarker(1, savedCFrame1, Color3.fromRGB(255, 0, 0))
        
        saveBtn1.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        task.wait(0.15)
        saveBtn1.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    end
end)

tpBtn1.MouseButton1Click:Connect(function()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if savedCFrame1 and hrp then
        hrp.CFrame = savedCFrame1
    else
        tpBtn1.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        task.wait(0.15)
        tpBtn1.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    end
end)

