-- 2. HAUPTMENÜ (Mit 5 Knöpfen)
local mainFrame = Instance.new("Frame", sg)
mainFrame.Size = UDim2.new(0, 320, 0, 320)
mainFrame.Position = UDim2.new(0.5, -160, 0.5, -160)
mainFrame.BackgroundColor3 = Color3.fromRGB(15, 10, 10)
mainFrame.Visible = false
mainFrame.Active = true
mainFrame.Draggable = true
Instance.new("UICorner", mainFrame).CornerRadius = UDim.new(0, 12)

local stroke2 = Instance.new("UIStroke", mainFrame)
stroke2.Thickness = 2
stroke2.Color = Color3.fromRGB(200, 0, 0)

local title2 = Instance.new("TextLabel", mainFrame)
title2.Size = UDim2.new(1, 0, 0.15, 0)
title2.BackgroundTransparency = 1
title2.Text = "👁️ ITACHI HUB 👁️"
title2.TextColor3 = Color3.fromRGB(230, 30, 30)
title2.TextSize = 20
title2.Font = Enum.Font.GothamBold

-- Funktion um Knöpfe leicht zu erstellen
local function createButton(name, posY, onClick)
    local btn = Instance.new("TextButton", mainFrame)
    btn.Size = UDim2.new(0.85, 0, 0.13, 0)
    btn.Position = UDim2.new(0.075, 0, posY, 0)
    btn.BackgroundColor3 = Color3.fromRGB(30, 20, 20)
    btn.Text = name
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.TextSize = 15
    btn.Font = Enum.Font.GothamBold
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    
    local btnStroke = Instance.new("UIStroke", btn)
    btnStroke.Thickness = 1
    btnStroke.Color = Color3.fromRGB(150, 0, 0)

    btn.MouseButton1Click:Connect(onClick)
    return btn
end

-- KNOPF 1: Fly
createButton("✈️ Fly", 0.18, function()
    loadstring(game:HttpGet("https://raw.githubusercontent.com/ilayaktas9-art/ilay-s-script/main/script.lua?v="..math.random()))()
end)

