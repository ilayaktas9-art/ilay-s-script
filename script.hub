-- LOGIK KEY SYSTEM
checkBtn.MouseButton1Click:Connect(function()
    if textBox.Text == CORRECT_KEY then
        checkBtn.Text = "✅ Richtig!"
        checkBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
        task.wait(0.8)
        keyFrame.Visible = false
        mainFrame.Visible = true
    else
        checkBtn.Text = "❌ Falsch!"
        checkBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
        task.wait(1.2)
        checkBtn.Text = "Check Key"
        checkBtn.BackgroundColor3 = Color3.fromRGB(180, 20, 20)
    end
end)

getKeyBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(KEY_LINK)
        getKeyBtn.Text = "📋 Kopiert!"
    else
        getKeyBtn.Text = "Fehler!"
    end
    task.wait(1.5)
    getKeyBtn.Text = "Get Key"
end)
